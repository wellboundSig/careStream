# Copy to .env on the closet PC (never commit .env)

# ── Logship SQL Server ───────────────────────────────────────
OASIS_DB_SERVER=LOGSHIP.ACUnion.local
OASIS_DB_PORT=1433
OASIS_DB_NAME=HCHB_WELLBOUND
OASIS_DB_USER=dataphone
OASIS_DB_PASS=

# ODBC driver name as shown in Windows "ODBC Data Sources (64-bit)"
# Common: "ODBC Driver 18 for SQL Server" or "ODBC Driver 17 for SQL Server"
OASIS_ODBC_DRIVER=ODBC Driver 18 for SQL Server
OASIS_DB_TRUST_CERT=yes

# ── Hashing (same pepper will eventually live in CareStream backend) ──
HCHB_LINK_PEPPER=

# ── AWS bridge (agent talks outbound HTTPS / AWS APIs only) ──
AWS_REGION=us-east-2
# Option A: poll SQS directly (IAM user/role on this PC)
HCHB_DUP_QUEUE_URL=
HCHB_DUP_RESULTS_QUEUE_URL=
# Option B: HTTP claim/result against API Gateway (recommended if no AWS IAM on PC)
HCHB_DUP_BRIDGE_URL=
HCHB_DUP_AGENT_TOKEN=

# Poll interval when idle (seconds)
POLL_SECONDS=2

# How long a claimed job may run before we report error (seconds)
JOB_TIMEOUT_SECONDS=60